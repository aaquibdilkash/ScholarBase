# ---- Build-time (NEXT_PUBLIC_* values are compiled into the client bundle) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# ---- Runtime ----
APP_ENV=                 # production | staging | development
APP_URL=                 # public origin override, read at runtime (no rebuild needed)
NODE_ENV=production
SOURCE_COMMIT=           # set by the Dockerfile build
DATABASE_URL=            # pooled or direct connection to this environment's database only
DIRECT_URL=              # direct connection, used by prisma migrate
DB_POOL_MAX=10
SUPABASE_CA_CERT_BASE64= # required in production mode
CRON_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TURNSTILE_SECRET_KEY=
GROQ_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_UNSUBSCRIBE_SECRET=
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRUST_CLOUDFLARE=false
