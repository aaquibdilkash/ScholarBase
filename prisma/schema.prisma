generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// GLOBAL ACTIVITY LOG (Added)
// ============================================
model UserActivity {
  id          String   @id @default(cuid())
  userId      String
  action      String // e.g., 'COMMENTED', 'REPLIED', 'VOTED', 'PUBLISHED'
  moduleType  String // e.g., 'SOCIAL_POST', 'ARTICLE', 'RESEARCH_EVENT'
  entityId    String // ID of the specific post/article
  entityTitle String // Stored statically to avoid JOINs on reads
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  // INDEX: getProfileSections filters the activity log on (userId, action)
  // and orders by createdAt DESC. This composite covers the full read pattern.
  @@index([userId, action, createdAt(sort: Desc)])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationType {
  RESEARCH_PAPER
  CONFERENCE_PROCEEDING
  PREPRINT
  BOOK
  BOOK_CHAPTER
  THESIS
  TECHNICAL_REPORT
  OTHER
}

enum Quartile {
  NONE
  Q1
  Q2
  Q3
  Q4
}

enum WosIndex {
  NONE
  SCIE
  SSCI
  AHCI
  ESCI
}

enum AbdcTier {
  NONE
  A_STAR @map("A*")
  A
  B
  C
}

enum OpenAccessStatus {
  CLOSED
  HYBRID
  GOLD
  DIAMOND
  UNKNOWN
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  RATING
  LINEAR_SCALE
  DATE
  LIKERT_SCALE
}

enum SurveyPrivacy {
  ANONYMOUS
  NON_ANONYMOUS
  HYBRID
}

enum SurveyStatus {
  OPEN
  CLOSED
}

enum ConversationType {
  DIRECT
}

enum DigestPreference {
  DAILY
  WEEKLY
  NEVER
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  published Boolean  @default(false)
  isFrozen  Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt DateTime?

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author   User             @relation(fields: [authorId], references: [id])
  comments ArticleComment[]
  votes    ArticleVote[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model Supervisor {
  id         String   @id @default(cuid())
  name       String
  university String
  department String
  about      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  editedAt DateTime?
  isFrozen   Boolean  @default(false)

  // Creator/owner of this supervisor profile
  authorId String

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  // Materialized recommendation aggregates (avg = ratingSum / recommendationCount)
  recommendationCount Int @default(0)
  ratingSum           Int @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes           SupervisorVote[]
  comments        SupervisorComment[]
  recommendations Recommendation[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model SocialPost {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  imageUrls String[]
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt DateTime?
  isFrozen  Boolean  @default(false)

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  comments SocialComment[]
  votes    SocialVote[]
  author   User            @relation(fields: [authorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model ArticleComment {
  id        String   @id @default(cuid())
  content   String
  articleId String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt DateTime?
  

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  article  Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author   User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent   ArticleComment?      @relation("ArticleReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ArticleComment[]     @relation("ArticleReplies")
  votes    ArticleCommentVote[]
  mentions Json?

  @@index([articleId, createdAt(sort: Desc)])
}

model ArticleVote {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  voteType  VoteType
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([articleId, userId])
  @@index([articleId, voteType])
}

model SocialComment {
  id           String   @id @default(cuid())
  content      String
  socialPostId String
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  author     User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent     SocialComment?      @relation("SocialReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    SocialComment[]     @relation("SocialReplies")
  socialPost SocialPost          @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  votes      SocialCommentVote[]
  mentions   Json?

  @@index([socialPostId, createdAt(sort: Desc)])
}

model ArticleCommentVote {
  id        String         @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime       @default(now())
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialCommentVote {
  id        String        @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime      @default(now())
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialVote {
  id           String     @id @default(cuid())
  socialPostId String
  userId       String
  voteType     VoteType
  createdAt    DateTime   @default(now())
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([socialPostId, userId])
  @@index([socialPostId, voteType])
}

// ============================================
// REPORT / MODERATION
// ============================================
enum ReportStatus {
  PENDING
  DISMISSED
  RESOLVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  PLAGIARISM
  MISINFORMATION
  OFF_TOPIC
  COPYRIGHT
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  entityId   String
  // Coarse entity category ("POST" | "COMMENT"); the exact model is resolved
  // from `module` in the server action (see MODULE_MODEL_MAP).
  entityType String
  // Where the report originated (SOCIAL_FEED, SUPERVISOR, SOCIAL_COMMENT, ...).
  module     String
  reason     ReportReason
  details    String?
  reporterId String
  status     ReportStatus  @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([entityId, status])
  @@index([status])
  @@index([module, status])
  @@index([reporterId, createdAt(sort: Desc)])
}

model HelpPost {
  id        String   @id @default(cuid())
  title     String
  subject   String
  category  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt DateTime?
  authorId  String
  isFrozen  Boolean  @default(false)

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes    HelpPostVote[]
  comments HelpPostComment[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model HelpPostVote {
  id         String   @id @default(cuid())
  helpPostId String
  userId     String
  voteType   VoteType
  createdAt  DateTime @default(now())

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([helpPostId, userId])
  @@index([helpPostId, voteType])
}

model HelpPostComment {
  id         String   @id @default(cuid())
  content    String
  helpPostId String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  parent  HelpPostComment?  @relation("HelpPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies HelpPostComment[] @relation("HelpPostReplies")

  votes    HelpPostCommentVote[]
  mentions Json?

  @@index([helpPostId, createdAt(sort: Desc)])
}

model HelpPostCommentVote {
  id        String          @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime        @default(now())
  comment   HelpPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Contribution {
  id              String             @id @default(cuid())
  title           String
  amount          Float?
  upiId           String?
  message         String
  paymentMethod   String?
  screenshotUrl   String?
  status          ContributionStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  authorId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  editedAt DateTime?
  isFrozen        Boolean            @default(false)

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes    ContributionVote[]
  comments ContributionComment[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model ContributionVote {
  id             String   @id @default(cuid())
  contributionId String
  userId         String
  voteType       VoteType
  createdAt      DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([contributionId, userId])
  @@index([contributionId, voteType])
}

model ContributionComment {
  id             String   @id @default(cuid())
  content        String
  contributionId String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  contribution Contribution              @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  author       User?                     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent       ContributionComment?      @relation("ContributionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ContributionComment[]     @relation("ContributionReplies")
  votes        ContributionCommentVote[]
  mentions     Json?

  @@index([contributionId, createdAt(sort: Desc)])
}

model ContributionCommentVote {
  id        String              @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime            @default(now())
  comment   ContributionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Publication {
  id                  String          @id @default(cuid())
  title               String
  authors             String
  publicationType     PublicationType
  journalOrConference String?
  publisher           String?
  year                Int?
  volume              String?
  issue               String?
  pages               String?
  doi                 String?
  isbn                String?
  url                 String?
  keywords            String?
  domain              String?
  abstract            String?
  isUserAuthor        Boolean         @default(false)
  isFrozen            Boolean         @default(false)
  authorId            String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  editedAt DateTime?

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    PublicationVote[]
  comments PublicationComment[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model PublicationVote {
  id            String      @id @default(cuid())
  publicationId String
  userId        String
  voteType      VoteType
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([publicationId, userId])
  @@index([publicationId, voteType])
}

model PublicationComment {
  id            String   @id @default(cuid())
  content       String
  publicationId String
  parentId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  publication Publication              @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author      User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent      PublicationComment?      @relation("PublicationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PublicationComment[]     @relation("PublicationReplies")
  votes       PublicationCommentVote[]
  mentions    Json?

  @@index([publicationId, createdAt(sort: Desc)])
}

model PublicationCommentVote {
  id        String             @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime           @default(now())
  comment   PublicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model User {
  id String @id

  contributionPosts        Contribution[]
  contributionVotes        ContributionVote[]
  contributionComments     ContributionComment[]
  contributionCommentVotes ContributionCommentVote[]

  helpPosts            HelpPost[]
  helpPostVotes        HelpPostVote[]
  helpPostComments     HelpPostComment[]
  helpPostCommentVotes HelpPostCommentVote[]

  email            String   @unique
  name             String?
  avatarUrl        String?
  handle           String?  @unique
  bio              String?
  githubUrl        String?
  orcidUrl         String?
  linkedinUrl      String?
  googleScholarUrl String?
  reputation       Int      @default(0)
  isAdmin          Boolean  @default(false)
  isFrozen         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  editedAt DateTime?

  // ZERO-COMPUTE COUNTERS & LOG
  followersCount       Int    @default(0)
  followingCount       Int    @default(0)
  isDeleted            Boolean @default(false)
  reportCount          Int     @default(0)
  activities           UserActivity[]

  articleCount         Int @default(0)
  socialPostCount      Int @default(0)
  jobVacancyCount      Int @default(0)
  phdAdmissionCount    Int @default(0)
  researchEventCount   Int @default(0)
  helpPostCount        Int @default(0)
  journalCount         Int @default(0)
  researchToolCount    Int @default(0)
  recommendationCount  Int @default(0)
  supervisorCount      Int @default(0)
  resultCount          Int @default(0)
  contributionCount    Int @default(0)
  publicationCount     Int @default(0)
  surveyCount          Int @default(0)
  researchGrantCount   Int @default(0)
  courseCount          Int @default(0)

  articles            Article[]
  articleComments     ArticleComment[]
  articleVotes        ArticleVote[]
  articleCommentVotes ArticleCommentVote[]

  following Follows[] @relation("following")
  followers Follows[] @relation("followers")
  blocks    Block[]   @relation("UserBlocks")
  blockedBy Block[]   @relation("UserBlocked")

  vacancies  JobVacancy[]
  admissions PhdAdmission[]
  events     ResearchEvent[]

  socialComments     SocialComment[]
  socialVotes        SocialVote[]
  socialCommentVotes SocialCommentVote[]
  socialPosts        SocialPost[]
  reports            Report[]

  jobVacancyVotes        JobVacancyVote[]
  jobVacancyComments     JobVacancyComment[]
  jobVacancyCommentVotes JobVacancyCommentVote[]

  phdAdmissionVotes        PhdAdmissionVote[]
  phdAdmissionComments     PhdAdmissionComment[]
  phdAdmissionCommentVotes PhdAdmissionCommentVote[]

  researchEventVotes        ResearchEventVote[]
  researchEventComments     ResearchEventComment[]
  researchEventCommentVotes ResearchEventCommentVote[]

  supervisorVotes        SupervisorVote[]
  supervisorComments     SupervisorComment[]
  supervisorCommentVotes SupervisorCommentVote[]

  recommendations            Recommendation[]
  recommendationVotes        RecommendationVote[]
  recommendationComments     RecommendationComment[]
  recommendationCommentVotes RecommendationCommentVote[]

  researchTools            ResearchTool[]
  researchToolVotes        ResearchToolVote[]
  researchToolComments     ResearchToolComment[]
  researchToolCommentVotes ResearchToolCommentVote[]

  researchGrants            ResearchGrant[]
  researchGrantVotes        ResearchGrantVote[]
  researchGrantComments     ResearchGrantComment[]
  researchGrantCommentVotes ResearchGrantCommentVote[]

  courses            Course[]
  courseVotes        CourseVote[]
  courseComments     CourseComment[]
  courseCommentVotes CourseCommentVote[]

  journals            Journal[]
  journalVotes        JournalVote[]
  journalComments     JournalComment[]
  journalCommentVotes JournalCommentVote[]

  results            Result[]
  resultVotes        ResultVote[]
  resultComments     ResultComment[]
  resultCommentVotes ResultCommentVote[]

   // Digest email frequency control (Notification Digest system)
  digestPreference DigestPreference @default(DAILY)

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  supervisors           Supervisor[]

  publications            Publication[]
  publicationVotes        PublicationVote[]
  publicationComments     PublicationComment[]
  publicationCommentVotes PublicationCommentVote[]

  surveys            ResearchSurvey[]
  surveyVotes        SurveyVote[]
  surveyComments     SurveyComment[]
  surveyCommentVotes SurveyCommentVote[]
  surveyResponses    SurveyResponse[]

  conversationsCreated     Conversation[]            @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]

  trendingScore Float   @default(0)

  // INDEX: The scholar directory (getScholars / getTrendingScholars) orders by
  // reputation and createdAt. The User table previously had NO non-unique
  // indexes on these columns, so every listing triggered a full-table filesort.
  @@index([trendingScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String
  type        String
  targetType  String?
  targetId    String?
  title       String
  body        String
  readAt      DateTime?
  // Tracks whether this notification has been included in a digest email
  isEmailed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt DateTime?
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  // CRITICAL: Isolates unsent notifications per user via B-Tree lookup,
  // preventing CPU-spiking sequential scans during digest cron runs.
  @@index([recipientId, isEmailed])
}

model Conversation {
  id            String                    @id @default(cuid())
  type          ConversationType          @default(DIRECT)
  createdById   String
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt DateTime?
  createdBy     User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@index([createdById, lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt DateTime?
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt DateTime?
  isDeleted Boolean?
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, readAt])
}

model ResearchTool {
  id          String   @id @default(cuid())
  name        String
  website     String
  use         String
  description String
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  editedAt DateTime?
  isFrozen    Boolean  @default(false)

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  author   User                  @relation(fields: [authorId], references: [id])
  comments ResearchToolComment[]
  votes    ResearchToolVote[]

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model ResearchToolVote {
  id             String       @id @default(cuid())
  researchToolId String
  userId         String
  voteType       VoteType
  createdAt      DateTime     @default(now())
  researchTool   ResearchTool @relation(fields: [researchToolId], references: [id], onDelete: Cascade)
