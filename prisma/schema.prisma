  comment   JobVacancyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SupervisorVote {
  id           String     @id @default(cuid())
  supervisorId String
  userId       String
  voteType     VoteType
  createdAt    DateTime   @default(now())
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([supervisorId, userId])
  @@index([supervisorId, voteType])
}

model SupervisorComment {
  id           String   @id @default(cuid())
  content      String
  supervisorId String
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  supervisor Supervisor              @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  author     User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent     SupervisorComment?      @relation("SupervisorReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    SupervisorComment[]     @relation("SupervisorReplies")
  votes      SupervisorCommentVote[]
  mentions   Json?

  @@index([supervisorId, createdAt(sort: Desc)])
}

model SupervisorCommentVote {
  id        String            @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime          @default(now())
  comment   SupervisorComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Recommendation {
  id                  String   @id @default(cuid())
  rating              Int
  feedback            String
  turnaroundTimeDays  Int
  responsivenessScore Int
  guidanceScore       Int
  isAnonymous         Boolean  @default(false)
  supervisorId        String
  authorId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  editedAt DateTime?
  isFrozen            Boolean  @default(false)

  // ZERO-COMPUTE FIELDS
  totalVotes    Int     @default(0)
  totalComments Int     @default(0)
  trendingScore Float   @default(0)
  isDeleted     Boolean @default(false)
  reportCount  Int     @default(0)

  supervisor Supervisor              @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  author     User                    @relation(fields: [authorId], references: [id])
  votes      RecommendationVote[]
  comments   RecommendationComment[]

    // NOTE: uniqueness of one ACTIVE recommendation per (author, supervisor) is
  // enforced by a PARTIAL unique index in SQL:
  //   CREATE UNIQUE INDEX ... ON "Recommendation"("authorId","supervisorId") WHERE "isDeleted" = false;
  // A full @@unique here would count soft-deleted tombstones and crash
  // re-submission after a delete.
  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
}

model RecommendationVote {
  id               String         @id @default(cuid())
  recommendationId String
  userId           String
  voteType         VoteType
  createdAt        DateTime       @default(now())
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id])

  @@unique([recommendationId, userId])
  @@index([recommendationId, voteType])
}

model RecommendationComment {
  id               String   @id @default(cuid())
  content          String
  recommendationId String
  parentId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  editedAt DateTime?

  // TOMBSTONING & COUNTERS
  authorId     String?
  totalVotes   Int     @default(0)
  totalReplies Int     @default(0)
  reportCount  Int     @default(0)

  recommendation Recommendation              @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  author         User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent         RecommendationComment?      @relation("RecommendationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        RecommendationComment[]     @relation("RecommendationReplies")
  votes          RecommendationCommentVote[]
  mentions       Json?

  @@index([recommendationId, createdAt(sort: Desc)])
}

model RecommendationCommentVote {
  id        String                @id @default(cuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime              @default(now())
  comment   RecommendationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}
