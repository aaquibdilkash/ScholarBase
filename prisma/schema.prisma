generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

model Article {
  id        String           @id @default(uuid())
  title     String
  slug      String           @unique
  excerpt   String?
  content   String
  published Boolean          @default(false)
  authorId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation(fields: [authorId], references: [id])
  comments  ArticleComment[]
  votes     ArticleVote[]
}

model Supervisor {
  id         String   @id @default(uuid())
  name       String
  university String
  department String
  about      String?
  createdAt  DateTime @default(now())

  // Creator/owner of this supervisor profile
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes           SupervisorVote[]
  comments        SupervisorComment[]
  recommendations Recommendation[]
}

model SocialPost {
  id        String          @id @default(uuid())
  content   String
  imageUrl  String?
  authorId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  SocialComment[]
  votes     SocialVote[]
  author    User            @relation(fields: [authorId], references: [id])
}

model ArticleComment {
  id        String               @id @default(uuid())
  content   String
  articleId String
  authorId  String
  parentId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  article   Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id])
  parent    ArticleComment?      @relation("ArticleReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ArticleComment[]     @relation("ArticleReplies")
  votes     ArticleCommentVote[]
}

model ArticleVote {
  id        String    @id @default(uuid())
  articleId String
  userId    String
  voteType  VoteType
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([articleId, userId])
  @@index([articleId, voteType])
}

model SocialComment {
  id           String              @id @default(uuid())
  content      String
  socialPostId String
  authorId     String
  parentId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  author       User                @relation(fields: [authorId], references: [id])
  parent       SocialComment?      @relation("SocialReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      SocialComment[]     @relation("SocialReplies")
  socialPost   SocialPost          @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  votes        SocialCommentVote[]
}

model ArticleCommentVote {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialCommentVote {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialVote {
  id           String     @id @default(uuid())
  socialPostId String
  userId       String
  voteType     VoteType
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([socialPostId, userId])
  @@index([socialPostId, voteType])
}

model HelpPost {
  id        String   @id @default(uuid())
  title     String
  subject   String
  category  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes    HelpPostVote[]
  comments HelpPostComment[]
}

model HelpPostVote {
  id         String    @id @default(uuid())
  helpPostId String
  userId     String
  voteType   VoteType

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([helpPostId, userId])
  @@index([helpPostId, voteType])
}

model HelpPostComment {
  id         String   @id @default(uuid())
  content    String
  helpPostId String
  authorId   String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  parent  HelpPostComment?  @relation("HelpPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies HelpPostComment[] @relation("HelpPostReplies")

  votes HelpPostCommentVote[]
}

model HelpPostCommentVote {
  id        String           @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType

  comment HelpPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model User {
  id String @id

  helpPosts            HelpPost[]
  helpPostVotes        HelpPostVote[]
  helpPostComments     HelpPostComment[]
  helpPostCommentVotes HelpPostCommentVote[]

  email       String   @unique
  name        String?
  avatarUrl   String?
  handle      String?  @unique
  bio         String?
  reputation  Int      @default(0)
  createdAt   DateTime @default(now())

  articles            Article[]
  articleComments     ArticleComment[]
  articleVotes        ArticleVote[]
  articleCommentVotes ArticleCommentVote[]

  following Follows[] @relation("following")
  followers Follows[] @relation("followers")

  vacancies  JobVacancy[]
  admissions PhdAdmission[]
  events     ResearchEvent[]

  socialComments     SocialComment[]
  socialVotes        SocialVote[]
  socialCommentVotes SocialCommentVote[]
  socialPosts        SocialPost[]

  // Trending interactions (votes + comments)
  jobVacancyVotes        JobVacancyVote[]
  jobVacancyComments     JobVacancyComment[]
  jobVacancyCommentVotes JobVacancyCommentVote[]

  phdAdmissionVotes        PhdAdmissionVote[]
  phdAdmissionComments     PhdAdmissionComment[]
  phdAdmissionCommentVotes PhdAdmissionCommentVote[]

  researchEventVotes        ResearchEventVote[]
  researchEventComments     ResearchEventComment[]
  researchEventCommentVotes ResearchEventCommentVote[]

  supervisorVotes        SupervisorVote[]
  supervisorComments     SupervisorComment[]
  supervisorCommentVotes SupervisorCommentVote[]

  recommendations                Recommendation[]
  recommendationVotes            RecommendationVote[]
  recommendationComments         RecommendationComment[]
  recommendationCommentVotes     RecommendationCommentVote[]

  researchTools            ResearchTool[]
  researchToolVotes        ResearchToolVote[]
  researchToolComments     ResearchToolComment[]
  researchToolCommentVotes ResearchToolCommentVote[]

  journals            Journal[]
  journalVotes        JournalVote[]
  journalComments     JournalComment[]
  journalCommentVotes JournalCommentVote[]

  results            Result[]
  resultVotes        ResultVote[]
  resultComments     ResultComment[]
  resultCommentVotes ResultCommentVote[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  supervisors           Supervisor[]
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  actorId     String
  type        String
  targetType  String?
  targetId    String?
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model ResearchTool {
  id          String                @id @default(uuid())
  name        String
  website     String
  use         String
  description String
  authorId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  author      User                  @relation(fields: [authorId], references: [id])
  comments    ResearchToolComment[]
  votes       ResearchToolVote[]
}

model ResearchToolVote {
  id             String       @id @default(uuid())
  researchToolId String
  userId         String
  voteType       VoteType
  researchTool   ResearchTool @relation(fields: [researchToolId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([researchToolId, userId])
  @@index([researchToolId, voteType])
}

model ResearchToolComment {
  id             String                    @id @default(uuid())
  content        String
  researchToolId String
  authorId       String
  parentId       String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  researchTool   ResearchTool              @relation(fields: [researchToolId], references: [id], onDelete: Cascade)
  author         User                      @relation(fields: [authorId], references: [id])
  parent         ResearchToolComment?      @relation("ResearchToolReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ResearchToolComment[]     @relation("ResearchToolReplies")
  votes          ResearchToolCommentVote[]
}

model ResearchToolCommentVote {
  id        String              @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   ResearchToolComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Journal {
  id           String           @id @default(uuid())
  title        String
  issn         String?
  impactFactor Float?
  scopus       String?
  abdcCategory String?
  publisher    String?
  website      String?
  authorId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  author       User             @relation(fields: [authorId], references: [id])
  comments     JournalComment[]
  votes        JournalVote[]
  about        String?
}

model JournalVote {
  id        String    @id @default(uuid())
  journalId String
  userId    String
  voteType  VoteType
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([journalId, userId])
  @@index([journalId, voteType])
}

model JournalComment {
  id        String               @id @default(uuid())
  content   String
  journalId String
  authorId  String
  parentId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  journal   Journal              @relation(fields: [journalId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id])
  parent    JournalComment?      @relation("JournalReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   JournalComment[]     @relation("JournalReplies")
  votes     JournalCommentVote[]
}

model JournalCommentVote {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   JournalComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Result {
  id               String   @id @default(cuid())
  title            String
  description      String
  type             String   // ADMISSION | VACANCY | EVENT | EXAM | OTHER
  category         String?  // e.g. "NET", "JRF", "SET", "GATE"
  conductingBody   String?  // e.g. "UGC", "NTA", "CBSE"
  session          String?  // e.g. "June 2024", "December 2024"
  notificationLink String?
  resultLink       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])

  votes    ResultVote[]
  comments ResultComment[]
}

model ResultVote {
  id       String    @id @default(uuid())
  resultId String
  userId   String
  voteType VoteType

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([resultId, userId])
  @@index([resultId, voteType])
}

model ResultComment {
  id        String   @id @default(uuid())
  content   String
  resultId  String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  parent  ResultComment?  @relation("ResultReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ResultComment[] @relation("ResultReplies")

  votes ResultCommentVote[]
}

model ResultCommentVote {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   ResultComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Follows {
  followerId  String
  followingId String
  follower    User   @relation("following", fields: [followerId], references: [id])
  following   User   @relation("followers", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model ResearchEvent {
  id               String    @id @default(cuid())
  title            String
  date             DateTime
  location         String
  description      String
  deadline         DateTime?
  notificationLink String?
  applyLink        String?
  createdAt        DateTime  @default(now())
  authorId         String
  author           User      @relation(fields: [authorId], references: [id])

  votes    ResearchEventVote[]
  comments ResearchEventComment[]
}

model ResearchEventVote {
  id              String    @id @default(uuid())
  researchEventId String
  userId          String
  voteType        VoteType

  researchEvent ResearchEvent @relation(fields: [researchEventId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([researchEventId, userId])
  @@index([researchEventId, voteType])
}

model ResearchEventComment {
  id              String   @id @default(uuid())
  content         String
  researchEventId String
  authorId        String
  parentId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  researchEvent ResearchEvent @relation(fields: [researchEventId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id])

  parent  ResearchEventComment?  @relation("ResearchEventReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ResearchEventComment[] @relation("ResearchEventReplies")

  votes ResearchEventCommentVote[]
}

model ResearchEventCommentVote {
  id        String               @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   ResearchEventComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model PhdAdmission {
  id               String   @id @default(cuid())
  university       String
  department       String
  deadline         DateTime
  description      String
  notificationLink String?
  applyLink        String?
  createdAt        DateTime @default(now())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])

  votes    PhdAdmissionVote[]
  comments PhdAdmissionComment[]
}

model PhdAdmissionVote {
  id             String    @id @default(uuid())
  phdAdmissionId String
  userId         String
  voteType       VoteType

  phdAdmission PhdAdmission @relation(fields: [phdAdmissionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([phdAdmissionId, userId])
  @@index([phdAdmissionId, voteType])
}

model PhdAdmissionComment {
  id             String   @id @default(uuid())
  content        String
  phdAdmissionId String
  authorId       String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  phdAdmission PhdAdmission @relation(fields: [phdAdmissionId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  parent  PhdAdmissionComment?  @relation("PhdAdmissionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PhdAdmissionComment[] @relation("PhdAdmissionReplies")

  votes PhdAdmissionCommentVote[]
}

model PhdAdmissionCommentVote {
  id        String              @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   PhdAdmissionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model JobVacancy {
  id               String   @id @default(cuid())
  title            String
  institution      String
  deadline         DateTime
  description      String
  notificationLink String?
  applyLink        String?
  createdAt        DateTime @default(now())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])

  votes    JobVacancyVote[]
  comments JobVacancyComment[]
}

model JobVacancyVote {
  id           String    @id @default(uuid())
  jobVacancyId String
  userId       String
  voteType     VoteType

  jobVacancy JobVacancy @relation(fields: [jobVacancyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([jobVacancyId, userId])
  @@index([jobVacancyId, voteType])
}

model JobVacancyComment {
  id           String   @id @default(uuid())
  content      String
  jobVacancyId String
  authorId     String
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobVacancy JobVacancy @relation(fields: [jobVacancyId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  parent  JobVacancyComment?  @relation("JobVacancyReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies JobVacancyComment[] @relation("JobVacancyReplies")

  votes JobVacancyCommentVote[]
}

model JobVacancyCommentVote {
  id        String            @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   JobVacancyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SupervisorVote {
  id           String     @id @default(uuid())
  supervisorId String
  userId       String
  voteType     VoteType
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([supervisorId, userId])
  @@index([supervisorId, voteType])
}

model SupervisorComment {
  id           String                  @id @default(uuid())
  content      String
  supervisorId String
  authorId     String
  parentId     String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  supervisor   Supervisor              @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  author       User                    @relation(fields: [authorId], references: [id])
  parent       SupervisorComment?      @relation("SupervisorReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      SupervisorComment[]     @relation("SupervisorReplies")
  votes        SupervisorCommentVote[]
}

model SupervisorCommentVote {
  id        String            @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   SupervisorComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Recommendation {
  id                  String                  @id @default(uuid())
  rating              Int
  feedback            String
  turnaroundTimeDays  Int
  responsivenessScore Int
  guidanceScore       Int
  supervisorId        String
  authorId            String
  createdAt           DateTime                @default(now())
  supervisor          Supervisor              @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  author              User                    @relation(fields: [authorId], references: [id])
  votes               RecommendationVote[]
  comments            RecommendationComment[]

  @@unique([authorId, supervisorId])
}

model RecommendationVote {
  id               String         @id @default(uuid())
  recommendationId String
  userId           String
  voteType         VoteType
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id])

  @@unique([recommendationId, userId])
  @@index([recommendationId, voteType])
}

model RecommendationComment {
  id               String                      @id @default(uuid())
  content          String
  recommendationId String
  authorId         String
  parentId         String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  recommendation   Recommendation              @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  author           User                        @relation(fields: [authorId], references: [id])
  parent           RecommendationComment?      @relation("RecommendationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          RecommendationComment[]     @relation("RecommendationReplies")
  votes            RecommendationCommentVote[]
}

model RecommendationCommentVote {
  id        String                @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  comment   RecommendationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}
