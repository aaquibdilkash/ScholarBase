  rating              Int
  feedback            String
  turnaroundTimeDays  Int
  responsivenessScore Int
  guidanceScore       Int
  supervisorId        String
  authorId            String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  isFrozen            Boolean                 @default(false)
  supervisor          Supervisor              @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  author              User                    @relation(fields: [authorId], references: [id])
  votes               RecommendationVote[]
  comments            RecommendationComment[]

  @@unique([authorId, supervisorId])
}

