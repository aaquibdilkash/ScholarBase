generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Article {
  id        String           @id @default(uuid())
  title     String
  slug      String           @unique
  excerpt   String?
  content   String
  published Boolean          @default(false)
  authorId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation(fields: [authorId], references: [id])
  comments  ArticleComment[]
  likes     ArticleLike[]
}

model Supervisor {
  id         String   @id @default(uuid())
  name       String
  university String
  department String
  createdAt  DateTime @default(now())
  reviews    Review[]
}

model Review {
  id           String     @id @default(uuid())
  feedback     String
  rating       Int
  turnaround   String
  supervisorId String
  createdAt    DateTime   @default(now())
  userId       String
  supervisor   Supervisor @relation(fields: [supervisorId], references: [id])
  author       User       @relation(fields: [userId], references: [id])
}

model SocialPost {
  id        String          @id @default(uuid())
  content   String
  imageUrl  String?
  authorId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  SocialComment[]
  likes     SocialLike[]
  author    User            @relation(fields: [authorId], references: [id])
}

model ArticleComment {
  id        String           @id @default(uuid())
  content   String
  articleId String
  authorId  String
  parentId  String?
  createdAt DateTime         @default(now())
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id])
  parent    ArticleComment?  @relation("ArticleReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ArticleComment[] @relation("ArticleReplies")
  likes     ArticleCommentLike[]
}

model ArticleLike {
  id        String  @id @default(uuid())
  articleId String
  userId    String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([articleId, userId])
}

model SocialComment {
  id           String          @id @default(uuid())
  content      String
  socialPostId String
  authorId     String
  parentId     String?
  createdAt    DateTime        @default(now())
  author       User            @relation(fields: [authorId], references: [id])
  parent       SocialComment?  @relation("SocialReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      SocialComment[] @relation("SocialReplies")
  socialPost   SocialPost      @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  likes        SocialCommentLike[]
}

model ArticleCommentLike {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

model SocialCommentLike {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}

model SocialLike {
  id           String     @id @default(uuid())
  socialPostId String
  userId       String
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([socialPostId, userId])
}

model User {
  id              String           @id
  email           String           @unique
  name            String?
  avatarUrl       String?
  handle          String?          @unique // New: Optional for now so it doesn't break existing users
  bio             String?                  // New: For the editable profile
  createdAt       DateTime         @default(now())  
  articles        Article[]
  articleComments ArticleComment[]
  articleLikes    ArticleLike[]
  articleCommentLikes ArticleCommentLike[]
  following       Follows[]        @relation("following")
  followers       Follows[]        @relation("followers")
  vacancies       JobVacancy[]
  admissions      PhdAdmission[]
  events          ResearchEvent[]
  reviews         Review[]
  socialComments  SocialComment[]
  socialLikes     SocialLike[]
  socialCommentLikes SocialCommentLike[]
  socialPosts     SocialPost[]
}

model Follows {
  followerId  String
  followingId String
  follower    User   @relation("following", fields: [followerId], references: [id])
  following   User   @relation("followers", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model ResearchEvent {
  id               String    @id @default(cuid())
  title            String
  date             DateTime
  location         String
  description      String
  deadline         DateTime?
  notificationLink String?
  applyLink        String?
  createdAt        DateTime  @default(now())
  authorId         String
  author           User      @relation(fields: [authorId], references: [id])
}

model PhdAdmission {
  id               String   @id @default(cuid())
  university       String
  department       String
  deadline         DateTime
  description      String
  notificationLink String?
  applyLink        String?
  createdAt        DateTime @default(now())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
}

model JobVacancy {
  id               String   @id @default(cuid())
  title            String
  institution      String
  type             String
  deadline         DateTime
  description      String
  notificationLink String?
  applyLink        String?
  createdAt        DateTime @default(now())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
}
