  parentId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  researchEvent ResearchEvent @relation(fields: [researchEventId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id])

  parent  ResearchEventComment?  @relation("ResearchEventReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ResearchEventComment[] @relation("ResearchEventReplies")

  votes ResearchEventCommentVote[]
}

model ResearchEventCommentVote {
