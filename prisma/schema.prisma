generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationType {
  RESEARCH_PAPER
  CONFERENCE_PROCEEDING
  PREPRINT
  BOOK
  BOOK_CHAPTER
  THESIS
  TECHNICAL_REPORT
  OTHER
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  RATING
  LINEAR_SCALE
  DATE
  LIKERT_SCALE
}

enum SurveyPrivacy {
  ANONYMOUS
  NON_ANONYMOUS
  HYBRID
}

enum SurveyStatus {
  OPEN
  CLOSED
}

enum ConversationType {
  DIRECT
}

model Article {
  id        String           @id @default(uuid())
  title     String
  slug      String           @unique
  excerpt   String?
  content   String
  published Boolean          @default(false)
  isFrozen  Boolean          @default(false)
  authorId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation(fields: [authorId], references: [id])
  comments  ArticleComment[]
  votes     ArticleVote[]
}

model Supervisor {
  id         String   @id @default(uuid())
  name       String
  university String
  department String
  about      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isFrozen   Boolean  @default(false)

  // Creator/owner of this supervisor profile
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes           SupervisorVote[]
  comments        SupervisorComment[]
  recommendations Recommendation[]
}

model SocialPost {
  id        String          @id @default(uuid())
  content   String
  imageUrl  String?
  imageUrls String[]
  authorId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  isFrozen  Boolean         @default(false)
  comments  SocialComment[]
  votes     SocialVote[]
  author    User            @relation(fields: [authorId], references: [id])
}

model ArticleComment {
  id        String               @id @default(uuid())
  content   String
  articleId String
  authorId  String
  parentId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  article   Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id])
  parent    ArticleComment?      @relation("ArticleReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ArticleComment[]     @relation("ArticleReplies")
  votes     ArticleCommentVote[]
}

model ArticleVote {
  id        String    @id @default(uuid())
  articleId String
  userId    String
  voteType  VoteType
  createdAt DateTime  @default(now())
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([articleId, userId])
  @@index([articleId, voteType])
}

model SocialComment {
  id           String              @id @default(uuid())
  content      String
  socialPostId String
  authorId     String
  parentId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  author       User                @relation(fields: [authorId], references: [id])
  parent       SocialComment?      @relation("SocialReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      SocialComment[]     @relation("SocialReplies")
  socialPost   SocialPost          @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  votes        SocialCommentVote[]
}

model ArticleCommentVote {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime       @default(now())
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialCommentVote {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime      @default(now())
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model SocialVote {
  id           String     @id @default(uuid())
  socialPostId String
  userId       String
  voteType     VoteType
  createdAt    DateTime   @default(now())
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([socialPostId, userId])
  @@index([socialPostId, voteType])
}

model HelpPost {
  id        String   @id @default(uuid())
  title     String
  subject   String
  category  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  isFrozen  Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes    HelpPostVote[]
  comments HelpPostComment[]
}

model HelpPostVote {
  id         String    @id @default(uuid())
  helpPostId String
  userId     String
  voteType   VoteType
  createdAt  DateTime  @default(now())

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([helpPostId, userId])
  @@index([helpPostId, voteType])
}

model HelpPostComment {
  id         String   @id @default(uuid())
  content    String
  helpPostId String
  authorId   String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  helpPost HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  parent  HelpPostComment?  @relation("HelpPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies HelpPostComment[] @relation("HelpPostReplies")

  votes HelpPostCommentVote[]
}

model HelpPostCommentVote {
  id        String           @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime         @default(now())
  comment   HelpPostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Contribution {
  id              String             @id @default(uuid())
  title           String
  amount          Float?
  upiId           String?
  message         String
  paymentMethod   String?
  screenshotUrl   String?
  status          ContributionStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  authorId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  isFrozen        Boolean            @default(false)
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes    ContributionVote[]
  comments ContributionComment[]
}

model ContributionVote {
  id             String       @id @default(uuid())
  contributionId String
  userId         String
  voteType       VoteType
  createdAt      DateTime     @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([contributionId, userId])
  @@index([contributionId, voteType])
}

model ContributionComment {
  id             String   @id @default(uuid())
  content        String
  contributionId String
  authorId       String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contribution Contribution                @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  author       User                        @relation(fields: [authorId], references: [id])
  parent       ContributionComment?        @relation("ContributionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ContributionComment[]       @relation("ContributionReplies")
  votes        ContributionCommentVote[]
}

model ContributionCommentVote {
  id        String              @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime            @default(now())
  comment   ContributionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Publication {
  id                String                 @id @default(uuid())
  title             String
  authors           String
  publicationType   PublicationType
  journalOrConference String?
  publisher         String?
  year              Int?
  volume            String?
  issue             String?
  pages             String?
  doi               String?
  isbn              String?
  url               String?
  keywords          String?
  domain            String?
  abstract          String?
  isUserAuthor      Boolean                @default(false)
  isFrozen          Boolean                @default(false)
  authorId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  author            User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes             PublicationVote[]
  comments          PublicationComment[]
}

model PublicationVote {
  id            String          @id @default(uuid())
  publicationId String
  userId        String
  voteType      VoteType
  createdAt     DateTime        @default(now())
  publication   Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id])

  @@unique([publicationId, userId])
  @@index([publicationId, voteType])
}

model PublicationComment {
  id            String                 @id @default(uuid())
  content       String
  publicationId String
  authorId      String
  parentId      String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  publication   Publication            @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author        User                   @relation(fields: [authorId], references: [id])
  parent        PublicationComment?    @relation("PublicationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PublicationComment[]   @relation("PublicationReplies")
  votes         PublicationCommentVote[]
}

model PublicationCommentVote {
  id        String              @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime            @default(now())
  comment   PublicationComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model User {
  id String @id

  contributionPosts     Contribution[]
  contributionVotes     ContributionVote[]
  contributionComments  ContributionComment[]
  contributionCommentVotes ContributionCommentVote[]

  helpPosts            HelpPost[]
  helpPostVotes        HelpPostVote[]
  helpPostComments     HelpPostComment[]
  helpPostCommentVotes HelpPostCommentVote[]

email       String   @unique
  name        String?
  avatarUrl   String?
  handle      String?  @unique
  bio         String?
  githubUrl     String?
  orcidId       String?
  linkedinUrl   String?
  googleScholarUrl String?
  reputation  Int      @default(0)
  isAdmin     Boolean  @default(false)
  isFrozen    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles            Article[]
  articleComments     ArticleComment[]
  articleVotes        ArticleVote[]
  articleCommentVotes ArticleCommentVote[]

following  Follows[] @relation("following")
  followers  Follows[] @relation("followers")
  blocks     Block[]   @relation("UserBlocks")
  blockedBy  Block[]   @relation("UserBlocked")

  vacancies  JobVacancy[]
  admissions PhdAdmission[]
  events     ResearchEvent[]

  socialComments     SocialComment[]
  socialVotes        SocialVote[]
  socialCommentVotes SocialCommentVote[]
  socialPosts        SocialPost[]

  // Trending interactions (votes + comments)
  jobVacancyVotes        JobVacancyVote[]
  jobVacancyComments     JobVacancyComment[]
  jobVacancyCommentVotes JobVacancyCommentVote[]

  phdAdmissionVotes        PhdAdmissionVote[]
  phdAdmissionComments     PhdAdmissionComment[]
  phdAdmissionCommentVotes PhdAdmissionCommentVote[]

  researchEventVotes        ResearchEventVote[]
  researchEventComments     ResearchEventComment[]
  researchEventCommentVotes ResearchEventCommentVote[]

  supervisorVotes        SupervisorVote[]
  supervisorComments     SupervisorComment[]
  supervisorCommentVotes SupervisorCommentVote[]

  recommendations                Recommendation[]
  recommendationVotes            RecommendationVote[]
  recommendationComments         RecommendationComment[]
  recommendationCommentVotes     RecommendationCommentVote[]

  researchTools            ResearchTool[]
  researchToolVotes        ResearchToolVote[]
  researchToolComments     ResearchToolComment[]
  researchToolCommentVotes ResearchToolCommentVote[]

  journals            Journal[]
  journalVotes        JournalVote[]
  journalComments     JournalComment[]
  journalCommentVotes JournalCommentVote[]

  results            Result[]
  resultVotes        ResultVote[]
  resultComments     ResultComment[]
  resultCommentVotes ResultCommentVote[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  supervisors           Supervisor[]

  publications            Publication[]
  publicationVotes        PublicationVote[]
  publicationComments     PublicationComment[]
  publicationCommentVotes PublicationCommentVote[]

  surveys              ResearchSurvey[]
  surveyVotes          SurveyVote[]
  surveyComments       SurveyComment[]
  surveyCommentVotes   SurveyCommentVote[]
  surveyResponses      SurveyResponse[]

  conversationsCreated Conversation[] @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  messagesSent Message[]
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  actorId     String
  type        String
  targetType  String?
  targetId    String?
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Conversation {
  id            String                     @id @default(uuid())
  type          ConversationType           @default(DIRECT)
  createdById   String
  lastMessageAt  DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  createdBy     User                       @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@index([createdById, lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ResearchTool {
  id          String                @id @default(uuid())
  name        String
  website     String
  use         String
  description String
  authorId    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  isFrozen    Boolean               @default(false)
  author      User                  @relation(fields: [authorId], references: [id])
  comments    ResearchToolComment[]
  votes       ResearchToolVote[]
}

model ResearchToolVote {
  id             String       @id @default(uuid())
  researchToolId String
  userId         String
  voteType       VoteType
  createdAt DateTime          @default(now())
  researchTool   ResearchTool @relation(fields: [researchToolId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([researchToolId, userId])
  @@index([researchToolId, voteType])
}

model ResearchToolComment {
  id             String                    @id @default(uuid())
  content        String
  researchToolId String
  authorId       String
  parentId       String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  researchTool   ResearchTool              @relation(fields: [researchToolId], references: [id], onDelete: Cascade)
  author         User                      @relation(fields: [authorId], references: [id])
  parent         ResearchToolComment?      @relation("ResearchToolReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ResearchToolComment[]     @relation("ResearchToolReplies")
  votes          ResearchToolCommentVote[]
}

model ResearchToolCommentVote {
  id        String              @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime            @default(now())
  comment   ResearchToolComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Journal {
  id           String           @id @default(uuid())
  title        String
  issn         String?
  impactFactor Float?
  scopus       String?
  abdcCategory String?
  publisher    String?
  website      String?
  authorId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  isFrozen     Boolean          @default(false)
  author       User             @relation(fields: [authorId], references: [id])
  comments     JournalComment[]
  votes        JournalVote[]
  about        String?
}

model JournalVote {
  id        String    @id @default(uuid())
  journalId String
  userId    String
  voteType  VoteType
  createdAt DateTime  @default(now())
  journal   Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([journalId, userId])
  @@index([journalId, voteType])
}

model JournalComment {
  id        String               @id @default(uuid())
  content   String
  journalId String
  authorId  String
  parentId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  journal   Journal              @relation(fields: [journalId], references: [id], onDelete: Cascade)
  author    User                 @relation(fields: [authorId], references: [id])
  parent    JournalComment?      @relation("JournalReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   JournalComment[]     @relation("JournalReplies")
  votes     JournalCommentVote[]
}

model JournalCommentVote {
  id        String         @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime       @default(now())
  comment   JournalComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Result {
  id               String   @id @default(cuid())
  title            String
  description      String
  type             String   // ADMISSION | VACANCY | EVENT | EXAM | OTHER
  category         String?  // e.g. "NET", "JRF", "SET", "GATE"
  conductingBody   String?  // e.g. "UGC", "NTA", "CBSE"
  session          String?  // e.g. "June 2024", "December 2024"
  notificationLink String?
  resultLink       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  authorId         String
  isFrozen         Boolean  @default(false)
  author           User     @relation(fields: [authorId], references: [id])

  votes    ResultVote[]
  comments ResultComment[]
}

model ResultVote {
  id       String    @id @default(uuid())
  resultId String
  userId   String
  voteType VoteType
  createdAt DateTime         @default(now())
  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([resultId, userId])
  @@index([resultId, voteType])
}

model ResultComment {
  id        String   @id @default(uuid())
  content   String
  resultId  String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  parent  ResultComment?  @relation("ResultReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ResultComment[] @relation("ResultReplies")

  votes ResultCommentVote[]
}

model ResultCommentVote {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime         @default(now())
  comment   ResultComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model ResearchSurvey {
  id           String          @id @default(uuid())
  title        String
  description  String?
  privacy      SurveyPrivacy   @default(HYBRID)
  status       SurveyStatus    @default(OPEN)
  shareData    Boolean         @default(false)
  authorId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isFrozen     Boolean         @default(false)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  votes       SurveyVote[]
  comments    SurveyComment[]
}

model SurveyQuestion {
  id         String             @id @default(uuid())
  surveyId   String
  type       SurveyQuestionType
  title      String
  required   Boolean            @default(false)
  order      Int
  minValue   Int?
  maxValue   Int?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  survey  ResearchSurvey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyQuestionOption[]
  answers SurveyAnswer[]
}

model SurveyQuestionOption {
  id         String @id @default(uuid())
  questionId String
  value      String
  label      String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SurveyResponse {
  id         String   @id @default(uuid())
  surveyId   String
  respondentId String?
  isAnonymous Boolean @default(false)
  createdAt  DateTime @default(now())

  survey  ResearchSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent User?       @relation(fields: [respondentId], references: [id])
  answers  SurveyAnswer[]
}

model SurveyAnswer {
  id         String @id @default(uuid())
  responseId String
  questionId String
  value      String // JSON string for multiple values

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SurveyVote {
  id        String      @id @default(uuid())
  surveyId  String
  userId    String
  voteType  VoteType
  createdAt DateTime         @default(now())
  survey ResearchSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id])

  @@unique([surveyId, userId])
  @@index([surveyId, voteType])
}

model SurveyComment {
  id        String   @id @default(uuid())
  content   String
  surveyId  String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  survey ResearchSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id])

  parent  SurveyComment?  @relation("SurveyReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies SurveyComment[] @relation("SurveyReplies")

  votes SurveyCommentVote[]
}

model SurveyCommentVote {
  id        String        @id @default(uuid())
  commentId String
  userId    String
  voteType  VoteType
  createdAt DateTime         @default(now())
  comment SurveyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, voteType])
}

model Follows {
  followerId  String
  followingId String
  follower    User   @relation("following", fields: [followerId], references: [id])
  following   User   @relation("followers", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ResearchEvent {
  id               String    @id @default(cuid())
  title            String
  date             DateTime
  location         String
  description      String
  deadline         DateTime?
  notificationLink String?
  applyLink        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  authorId         String
  isFrozen         Boolean  @default(false)
  author           User      @relation(fields: [authorId], references: [id])

  votes    ResearchEventVote[]
  comments ResearchEventComment[]
}

model ResearchEventVote {
  id              String    @id @default(uuid())
  researchEventId String
  userId          String
  voteType        VoteType
  createdAt DateTime         @default(now())
  researchEvent ResearchEvent @relation(fields: [researchEventId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([researchEventId, userId])
  @@index([researchEventId, voteType])
}

model ResearchEventComment {
  id              String   @id @default(uuid())
  content         String
  researchEventId String
